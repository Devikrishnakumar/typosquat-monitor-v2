<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">

<style>

@page {
    size: A4;
    margin: 28px;
}

body {
    font-family: Arial, sans-serif;
    color: #1f2937;
    font-size: 10px;
}

h1 {
    color: #2f2b7c;
    border-bottom: 3px solid #4f46e5;
    padding-bottom: 10px;
}

h2 {
    color: #343a78;
    margin-top: 22px;
}

h3 {
    color: #4f46e5;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
}

th,
td {
    border: 1px solid #d9dce7;
    padding: 7px;
    vertical-align: top;
}

th {
    background-color: #f2f4fa;
    color: #343a78;
}

.card {
    border: 1px solid #d9dce7;
    padding: 10px;
    margin-top: 10px;
    background-color: #fafbff;
}

.simulation-banner {
    background-color: #fff3cd;
    border: 1px solid #e2bd55;
    padding: 10px;
    margin-bottom: 15px;
    font-weight: bold;
}

.risk-badge {
    display: inline-block;
    padding: 6px 14px;
    color: white;
    font-weight: bold;
    border-radius: 4px;
}

.risk-high {
    background-color: #dc3545;
}

.risk-medium {
    background-color: #f59e0b;
    color: #111827;
}

.risk-low {
    background-color: #16a34a;
}

.compare-table td {
    width: 50%;
    text-align: center;
}

.compare-title {
    font-weight: bold;
    padding: 7px;
    background-color: #eef0ff;
    color: #343a78;
}

.screenshot {
    max-width: 95%;
    max-height: 620px;
    border: 1px solid #bfc4d4;
    margin-top: 8px;
}

.small-screenshot {
    max-width: 95%;
    max-height: 500px;
    border: 1px solid #bfc4d4;
}

.code {
    font-family: Courier, monospace;
    background-color: #f4f5f8;
    padding: 4px;
}

.footer {
    margin-top: 30px;
    font-size: 8px;
    color: #777;
}

.page-break {
    page-break-before: always;
}

.ok {
    color: #15803d;
    font-weight: bold;
}

.warn {
    color: #b45309;
    font-weight: bold;
}

</style>
</head>

<body>

<h1>Typosquat &amp; Brand Impersonation Monitor</h1>

{% if is_simulation %}
<div class="simulation-banner">
    SIMULATION REPORT — This evidence package was generated by the
    dashboard's controlled simulation workflow. It is not, by itself,
    a determination of malicious intent.
</div>
{% endif %}

<div class="card">
    <strong>Report Type:</strong>
    {% if is_simulation %}
        Simulation Evidence Report
    {% else %}
        Detection / Abuse Report
    {% endif %}
</div>

<h2>1. Detection Summary</h2>

<table>
    <tr>
        <th>Detected Domain</th>
        <td>{{ domain }}</td>
    </tr>

    {% if decoded_domain %}
    <tr>
        <th>Decoded Domain</th>
        <td>{{ decoded_domain }}</td>
    </tr>
    {% endif %}

    <tr>
        <th>Matched Brand</th>
        <td>{{ matched_brand }}</td>
    </tr>

    {% if official_domain %}
    <tr>
        <th>Official Domain Used for Simulation</th>
        <td>{{ official_domain }}</td>
    </tr>
    {% endif %}

    <tr>
        <th>Detection Time</th>
        <td>{{ detected_at }}</td>
    </tr>

    <tr>
        <th>Domain Status</th>
        <td>
            {% if is_live %}
                Live
            {% else %}
                Not Live / Unknown
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Risk</th>
        <td>
            <span class="risk-badge risk-{{ risk_level|lower }}">
                {{ risk_score }}/100 — {{ risk_level }}
            </span>
        </td>
    </tr>
</table>

{% if is_simulation %}
<h2>2. Simulation Result</h2>

<table>
    <tr>
        <th>Production Database Risk</th>
        <td>
            {% if production_risk_score is not none %}
                {{ production_risk_score }}/100
                — {{ production_risk_level }}
            {% else %}
                Not available
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Simulation Risk</th>
        <td>
            {{ risk_score }}/100 — {{ risk_level }}
        </td>
    </tr>

    <tr>
        <th>Simulation Database Effect</th>
        <td class="ok">
            No PostgreSQL candidate row was inserted or modified.
        </td>
    </tr>
</table>
{% endif %}

<h2>3. Certificate / Domain Evidence</h2>

<table>
    <tr>
        <th>Detection Source</th>
        <td>{{ certificate_source }}</td>
    </tr>

    <tr>
        <th>Observed Domain</th>
        <td>{{ domain }}</td>
    </tr>

    <tr>
        <th>Decoded Domain</th>
        <td>
            {% if decoded_domain %}
                {{ decoded_domain }}
            {% else %}
                Not available
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>DNS / Live Status</th>
        <td>
            {% if is_live %}
                Resolves / reachable during analysis
            {% else %}
                Not reachable during analysis
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Certificate Metadata</th>
        <td>{{ certificate_details_note }}</td>
    </tr>
</table>

<h2>4. Detection Pipeline</h2>

<table>

{% for step in detection_pipeline %}
<tr>
    <td>{{ loop.index }}</td>
    <td>{{ step }}</td>
</tr>
{% endfor %}

</table>

<h2>5. Risk Evidence</h2>

<table>
    <tr>
        <th>Visual Similarity</th>
        <td>
            {% if visual_similarity is not none %}
                {{ "%.4f"|format(visual_similarity) }}
            {% else %}
                N/A
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Login Form Detected</th>
        <td>
            {% if has_login_form %}
                Yes
            {% else %}
                No
            {% endif %}
        </td>
    </tr>

    {% if risk_breakdown %}
    <tr>
        <th>Risk Breakdown</th>
        <td>
            {% for key, value in risk_breakdown.items() %}
                {{ key }} = {{ value }}<br>
            {% endfor %}
        </td>
    </tr>
    {% endif %}

</table>

{% if reference_screenshot_path or screenshot_path %}
<div class="page-break"></div>

<h2>6. Website Visual Comparison</h2>

<table class="compare-table">

<tr>
    <td>
        <div class="compare-title">
            ORIGINAL / REFERENCE
        </div>
    </td>

    <td>
        <div class="compare-title">
            DETECTED / SIMULATED
        </div>
    </td>
</tr>

<tr>
    <td>
        {% if reference_screenshot_path %}
            <img
                src="{{ reference_screenshot_path }}"
                class="screenshot"
                alt="Original website"
            >
        {% else %}
            <em>Original screenshot unavailable.</em>
        {% endif %}
    </td>

    <td>
        {% if screenshot_path %}
            <img
                src="{{ screenshot_path }}"
                class="screenshot"
                alt="Detected website"
            >
        {% else %}
            <em>Detected screenshot unavailable.</em>
        {% endif %}
    </td>
</tr>

</table>

{% endif %}

{% if is_simulation %}

<div class="page-break"></div>

<h2>7. Login Page Comparison</h2>

<table>
    <tr>
        <th>Login-page visual similarity</th>
        <td>
            {% if login_similarity is not none %}
                {{ "%.4f"|format(login_similarity) }}
            {% else %}
                Not available
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Login structure match</th>
        <td>
            {% if login_comparison.same_login_structure %}
                Consistent observed structure
            {% else %}
                Structure differs
            {% endif %}
        </td>
    </tr>

    <tr>
        <th>Input field types match</th>
        <td>
            {% if login_comparison.same_field_types %}
                Yes
            {% else %}
                No
            {% endif %}
        </td>
    </tr>
</table>

<table class="compare-table">

<tr>
    <td>
        <div class="compare-title">
            ORIGINAL LOGIN PAGE
        </div>
    </td>

    <td>
        <div class="compare-title">
            DETECTED / SIMULATED LOGIN PAGE
        </div>
    </td>
</tr>

<tr>
    <td>
        {% if reference_login_screenshot_path %}
            <img
                src="{{ reference_login_screenshot_path }}"
                class="small-screenshot"
                alt="Original login page"
            >
        {% else %}
            <em>Original login page screenshot unavailable.</em>
        {% endif %}
    </td>

    <td>
        {% if candidate_login_screenshot_path %}
            <img
                src="{{ candidate_login_screenshot_path }}"
                class="small-screenshot"
                alt="Simulated detected login page"
            >
        {% else %}
            <em>Detected login page screenshot unavailable.</em>
        {% endif %}
    </td>
</tr>

</table>

<h3>Login Technical Evidence</h3>

<table>

<tr>
    <th></th>
    <th>Original</th>
    <th>Detected</th>
</tr>

<tr>
    <td>Forms</td>
    <td>{{ reference_login.form_count }}</td>
    <td>{{ candidate_login.form_count }}</td>
</tr>

<tr>
    <td>Password fields</td>
    <td>{{ reference_login.password_fields }}</td>
    <td>{{ candidate_login.password_fields }}</td>
</tr>

<tr>
    <td>Email fields</td>
    <td>{{ reference_login.email_fields }}</td>
    <td>{{ candidate_login.email_fields }}</td>
</tr>

<tr>
    <td>Submit controls</td>
    <td>{{ reference_login.submit_controls }}</td>
    <td>{{ candidate_login.submit_controls }}</td>
</tr>

<tr>
    <td>Login form</td>
    <td>
        {{ "Yes" if reference_login.login_form else "No" }}
    </td>
    <td>
        {{ "Yes" if candidate_login.login_form else "No" }}
    </td>
</tr>

</table>

<h3>Observed Login Comparison Notes</h3>

<ul>
{% for note in login_comparison.differences %}
    <li>{{ note }}</li>
{% endfor %}
</ul>

<h3>Observed Suspicious Phrases</h3>

<table>
    <tr>
        <th>Original</th>
        <th>Detected</th>
    </tr>

    <tr>
        <td>
            {% if reference_login.suspicious_phrases %}
                {{ reference_login.suspicious_phrases|join(", ") }}
            {% else %}
                None detected
            {% endif %}
        </td>

        <td>
            {% if candidate_login.suspicious_phrases %}
                {{ candidate_login.suspicious_phrases|join(", ") }}
            {% else %}
                None detected
            {% endif %}
        </td>
    </tr>
</table>

{% endif %}

<h2>
    {% if is_simulation %}
        8. Technical Conclusion
    {% else %}
        7. Technical Conclusion
    {% endif %}
</h2>

<p>
    This document records the automated observations produced by the
    Typosquat &amp; Brand Impersonation Monitor.
</p>

{% if is_simulation %}
<p class="warn">
    Simulation status: completed. The screenshots and login analysis
    were generated by the Playwright simulation workflow and should be
    treated as demonstration/analysis evidence rather than a standalone
    legal or forensic determination.
</p>
{% else %}
<p>
    The candidate was processed by the configured detection pipeline
    and the recorded enrichment signals were used to calculate the
    stored risk classification.
</p>
{% endif %}

<h2>
    {% if is_simulation %}
        9. Final Status
    {% else %}
        8. Final Status
    {% endif %}
</h2>

<table>

<tr>
    <th>Risk Level</th>
    <td>
        <span class="risk-badge risk-{{ risk_level|lower }}">
            {{ risk_level }}
        </span>
    </td>
</tr>

<tr>
    <th>Evidence Package</th>
    <td>
        Generated
    </td>
</tr>

<tr>
    <th>Manual Review</th>
    <td>
        Recommended before any external action.
    </td>
</tr>

</table>

<div class="footer">
    Typosquat &amp; Brand Impersonation Monitor<br>
    Generated at: {{ generated_at }}
</div>

</body>
</html>
