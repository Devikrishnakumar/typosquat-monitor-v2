<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
    body { font-family: Arial, sans-serif; margin: 40px; color: #222; }
    h1 { color: #c0392b; border-bottom: 3px solid #c0392b; padding-bottom: 10px; }
    h2 { color: #2c3e50; margin-top: 30px; }
    .risk-badge { display: inline-block; padding: 6px 16px; border-radius: 4px; font-weight: bold; color: white; }
    .risk-high { background-color: #e74c3c; }
    .risk-medium { background-color: #f39c12; }
    .risk-low { background-color: #27ae60; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    td, th { border: 1px solid #ddd; padding: 10px; text-align: left; }
    th { background-color: #f4f4f4; }
    .compare-table td { text-align: center; vertical-align: top; width: 50%; }
    .compare-label { font-weight: bold; padding: 8px; }
    .compare-label.real { background-color: #27ae60; color: white; }
    .compare-label.fake { background-color: #e74c3c; color: white; }
    .screenshot { max-width: 100%; border: 1px solid #ccc; margin-top: 8px; }
    .footer { margin-top: 40px; font-size: 12px; color: #888; }
</style>
</head>
<body>

<h1>Phishing / Brand Impersonation Abuse Report</h1>

<p>
    This report was auto-generated by a Typosquat & Brand Impersonation Domain Monitor,
    which detected the domain below as a likely phishing/brand impersonation attempt
    against <strong>{{ matched_brand }}</strong>.
</p>

<h2>Detection Summary</h2>
<table>
    <tr><th>Suspicious Domain</th><td>{{ domain }}</td></tr>
    {% if decoded_domain %}
    <tr><th>Decoded (Punycode)</th><td>{{ decoded_domain }}</td></tr>
    {% endif %}
    <tr><th>Impersonating Brand</th><td>{{ matched_brand }}</td></tr>
    <tr><th>Detected At</th><td>{{ detected_at }}</td></tr>
    <tr><th>Domain Status</th><td>{{ "Live" if is_live else "Not Live" }}</td></tr>
    <tr><th>Risk Score</th>
        <td><span class="risk-badge risk-{{ risk_level|lower }}">{{ risk_score }}/100 — {{ risk_level }}</span></td>
    </tr>
</table>

<h2>Evidence</h2>
<table>
    <tr><th>Visual Similarity to {{ matched_brand }}</th><td>{{ visual_similarity if visual_similarity is not none else "N/A" }}</td></tr>
    <tr><th>Login Form Detected</th><td>{{ "Yes" if has_login_form else "No" }}</td></tr>
</table>

{% if screenshot_path or reference_screenshot_path %}
<h2>Visual Comparison — Real Site vs. Suspicious Site</h2>
<table class="compare-table">
    <tr>
        <td><div class="compare-label real">REAL: {{ matched_brand }}</div></td>
        <td><div class="compare-label fake">SUSPICIOUS: {{ domain }}</div></td>
    </tr>
    <tr>
        <td>
            {% if reference_screenshot_path %}
            <img src="{{ reference_screenshot_path }}" class="screenshot" alt="Real brand site">
            {% else %}
            <p><em>Reference screenshot unavailable</em></p>
            {% endif %}
        </td>
        <td>
            {% if screenshot_path %}
            <img src="{{ screenshot_path }}" class="screenshot" alt="Suspicious site">
            {% else %}
            <p><em>Suspicious site screenshot unavailable</em></p>
            {% endif %}
        </td>
    </tr>
</table>
{% endif %}

<h2>Registrar / Abuse Contact Information</h2>
{% if registrar %}
<table>
    <tr><th>Registrar</th><td>{{ registrar }}</td></tr>
    <tr><th>Domain Created</th><td>{{ creation_date if creation_date else "Unknown" }}</td></tr>
    <tr><th>Abuse Email(s)</th><td>{{ emails|join(", ") if emails else "Not listed — check registrar's abuse contact page" }}</td></tr>
    <tr><th>Name Servers</th><td>{{ name_servers|join(", ") if name_servers else "Unknown" }}</td></tr>
</table>
{% else %}
<p><em>Registrar information could not be retrieved automatically. Please look up abuse contact details manually via
<a href="https://lookup.icann.org/en/lookup">ICANN Lookup</a> using the domain name above.</em></p>
{% endif %}

<h2>Recommended Action</h2>
<p>
    We recommend reporting this domain to the registrar's abuse team and, if hosted content is confirmed malicious,
    to the hosting provider's abuse contact as well. Include this report as supporting evidence.
</p>

<div class="footer">
    Report generated automatically by Typosquat & Brand Impersonation Domain Monitor.<br>
    Generated at: {{ generated_at }}
</div>

</body>
</html>
